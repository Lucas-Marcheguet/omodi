<odoo>
  <record id="thing_form" model="ir.ui.view">
    <field name="name">up.thing.form</field>
    <field name="model">up.thing</field>
    <field name="arch" type="xml"><form><field name="f_removed"/><field name="f_type"/><group name="grp"/></form></field>
  </record>
  <template id="tpl_base"><div class="removed_cls"><span class="kept_cls"/></div></template>
  <template id="tpl_gone"><p>gone</p></template>
  <template id="tpl_mod"><div class="a"><t t-call="up.tpl_gone"/></div></template>
  <record id="group_gone" model="res.groups"><field name="name">Gone</field></record>
  <record id="group_ok" model="res.groups"><field name="name">Ok</field></record>
  <record id="act_moved" model="ir.actions.act_window"><field name="name">Moved</field><field name="res_model">up.thing</field></record>
</odoo>
